{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run pytest *)",
      "Bash(uv run pre-commit run *)",
      "Bash(uv run supermarket-scraper list)",
      "Bash(uv run supermarket-scraper --help)",
      "Bash(uv lock --check)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./scraper/.env)",
      "Edit(./scraper/.env)",
      "Edit(./scraper/uv.lock)",
      "Edit(./scraper/data/**)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR/scraper\" && uv run ruff check --fix --quiet . && uv run ruff format --quiet . || true"
          }
        ]
      }
    ]
  }
}
