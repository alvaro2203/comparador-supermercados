# Copy to .env and adjust. Every value shown is the default.

# Database: any SQLAlchemy URL. Switching engines needs no code changes.
#   SQLite:     sqlite:///data/supermarkets.db
#   PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/supermarkets   (uv sync --extra postgres)
#   MySQL:      mysql+pymysql://user:pass@localhost:3306/supermarkets         (uv sync --extra mysql)
SCRAPER_DATABASE_URL=sqlite:///data/supermarkets.db
SCRAPER_DATABASE_ECHO=false

# Day boundary used to bucket daily price snapshots.
SCRAPER_TIMEZONE=Europe/Madrid

SCRAPER_LOG_LEVEL=INFO
# text | json
SCRAPER_LOG_FORMAT=text

# HTTP politeness and resilience.
SCRAPER_HTTP_TIMEOUT_SECONDS=20
SCRAPER_HTTP_MAX_RETRIES=4
SCRAPER_HTTP_BACKOFF_BASE_SECONDS=1
SCRAPER_HTTP_BACKOFF_MAX_SECONDS=30
SCRAPER_HTTP_MAX_CONCURRENCY=4
SCRAPER_HTTP_MIN_INTERVAL_SECONDS=0.25
SCRAPER_HTTP_USER_AGENT=supermarket-scraper/0.1 (+price comparison research)

# Product detail enrichment (EAN, brand, ingredients). Only never-enriched products are fetched,
# at most SCRAPER_DETAILS_LIMIT per run. `supermarket-scraper enrich` fetches the whole backlog.
SCRAPER_FETCH_DETAILS=true
SCRAPER_DETAILS_LIMIT=500

# Safety net: skip delisting if more than this fraction of products vanishes in one run.
SCRAPER_MAX_DELIST_RATIO=0.20

# Mercadona: prices depend on the warehouse (mad1 Madrid, vlc1 Valencia, bcn1 Barcelona, ...).
# The project tracks Madrid. The warehouse is not stored with each price: changing it on an
# existing database mixes regions in the price history, so use a new database instead.
MERCADONA_BASE_URL=https://tienda.mercadona.es
MERCADONA_WAREHOUSE=mad1
MERCADONA_LANGUAGE=es
